PHPDEV_PHP_VERSION=8.5

PHPDEV_NGINX_VERSION=latest

PHPDEV_REDIS_VERSION=latest
PHPDEV_REDIS_INSIGHT_VERSION=latest

PHPDEV_POSTGRES_VERSION=18
PHPDEV_POSTGRES_ROOT_PASSWORD=root
PHPDEV_POSTGRES_DATA_PATH="/var/lib/postgresql"

PHPDEV_MARIADB_VERSION=12
PHPDEV_MARIADB_ROOT_PASSWORD=root
PHPDEV_MARIADB_DATA_PATH="/var/lib/mysql"

PHPDEV_MYSQL_VERSION=9
PHPDEV_MYSQL_ROOT_PASSWORD=root
PHPDEV_MYSQL_DATA_PATH="/var/lib/mysql"

PHPDEV_MONGODB_VERSION=latest
PHPDEV_MONGODB_ROOT_USERNAME=root
PHPDEV_MONGODB_ROOT_PASSWORD=root

PHPDEV_MONGOE_VERSION=latest
PHPDEV_MONGOE_ROOT_USERNAME=root
PHPDEV_MONGOE_ROOT_PASSWORD=root

# Comma-separated list of optional services to start (e.g. redis,postgres,mailpit)

COMPOSE_PROFILES=redis
